---
import { contours, route } from '../lib/topo';
interface Props { variant?: 'hero' | 'band' | 'finish'; class?: string; withRoute?: boolean }
const { variant = 'hero', class: cls = '', withRoute = true } = Astro.props;
const W = 1600, H = 1000;
const sets = {
  hero: [ { cx: 1180, cy: 330, rings: 14, step: 34, seed: 1.3 }, { cx: 260, cy: 860, rings: 10, step: 38, seed: 4.1 } ],
  band: [ { cx: 420, cy: 520, rings: 12, step: 40, seed: 2.2 }, { cx: 1380, cy: 200, rings: 8, step: 44, seed: 0.6 } ],
  finish: [ { cx: 800, cy: 1100, rings: 18, step: 42, seed: 5.2 } ],
}[variant];
const lines = contours(W, H, sets);
const r = route(W, H, variant === 'band' ? 2.4 : 0.7);
---
<svg class={`topo topo--${variant} ${cls}`} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <g class="topo__rings">{lines.map((d, i) => <path d={d} class={i % 5 === 4 ? 'is-index' : ''} />)}</g>
  {withRoute && <path class="topo__route" d={r} pathLength="1" />}
</svg>
